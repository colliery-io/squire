# Copy to keystore.properties (gitignored) and fill in. Generate a keystore with:
#   keytool -genkeypair -keystore keystore/squire-release.jks -alias squire \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/squire-release.jks
storePassword=CHANGE_ME
keyAlias=squire
keyPassword=CHANGE_ME
