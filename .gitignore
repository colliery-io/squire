target/
# macOS Finder metadata — never useful in the repo.
.DS_Store
**/.DS_Store
# Toolchain jars fetched on demand (openapi-generator-cli).
tools/
# Generated client SDKs — regenerated from crates/api/openapi.json via clients/generate-sdk.sh.
clients/squire-sdk/

# Squire Android Gradle project (commit the wrapper jar + scripts; ignore build/IDE/local state).
clients/squire-android/.gradle/
clients/squire-android/build/
clients/squire-android/**/build/
clients/squire-android/local.properties
clients/squire-android/.idea/
clients/squire-android/.kotlin/
# Release signing material — never commit the keystore or its credentials.
clients/squire-android/keystore/
clients/squire-android/keystore.properties
